    "page4.html": {
      "settings": {
        "title": "LabEquipments",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": 4
      },
      "components": [
        {
          "_inherit": "msg-box8",
          "_styles": {
            ".mbr-section-title, p": {
              "color": "#000"
            },
            ".lead P": {
              "font-size": "22px"
            }
          },
          "_params": {
            "showTitle": true,
            "showText": true,
            "showButton": true,
            "paddingTop": "3",
            "paddingBottom": "3",
            "bgImageRadio": false,
            "bgImage": "@THEME_PATH@/components/_images/desert.jpg",
            "parallax": true,
            "bgColorRadio": true,
            "bgColor": "#ffffff",
            "bgVideoRadio": false,
            "bgVideo": {
              "url": "https://www.youtube.com/watch?v=uNCr7NdOJgw"
            },
            "overlay": false,
            "overlayColor": "#222",
            "overlayOpacity": 0.5
          },
          "title": "<br>NURTECH FFXI INSTALLATION",
          "text": "<p>Please download the prerequisites found here:</p><p>1- Directx download</p><p>2- Microsoft Visual C++ Redistributable 2017 Download</p><p>3- .NET Framework Download&nbsp;</p><p>Finally, <b>Nurtech FFXI Installer</b> (you do not need to update Final Fantsay or PlayOnline, you should be able to play immediatly) Download</p><p><b>Windower Location:</b> C:\\Program Files (x86)\\PlayOnline\\Windower\\Windower.exe</p><p><b>Ashita Location:</b> C:\\Program Files (x86)\\PlayOnline\\Ashita\\Ashita.exe</p><p><b>Note: </b>Windows 8 and up, you might need to go to \"turn on windows features\" --&gt; and turn on \"Legacy components\" and \"Direct play\"</p><p><b>Note: </b>For the first launch , please allow xiloader.exe and ashita through windows firewall</p>",
          "_tags": [
            "Theme"
          ],
          "button": "<a data-app-btn=\"true\" class=\"btn btn-secondary\" href=\"https://mobirise.com\" data-toolbar=\"-mbrBtnMove\"><strong>Nurtech FFXI Installer (Download)</strong></a>",
          "_name": "msg-box3",
          "_anchor": "msg-box3-1n"
        },
        {
          "_params": {
            "showTitle": true,
